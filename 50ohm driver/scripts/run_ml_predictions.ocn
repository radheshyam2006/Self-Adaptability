; run_ml_predictions.ocn
; Auto-generated Ocean script to verify ML-predicted trim codes
; Generated from: TSMC28nm_DRV_ML_MAR6_LookUP_Table_Mar20_ML Predictions.xlsx
; Resistance is measured in the 200ns-250ns window, so tran stop = 300ns (saves ~40% time)

simulator('spectre)
design("tsmc28_tx_tb" "tx_drv_ML" "schematic_seriliazer_top")
resultsDir("./ml_prediction_results")

envOption('termDirectionMismatch "ignore" 'termMismatch "ignore")
saveOption( ?infoOptions list(list("modelParameter" "models" "rawfile" "" "" "" t) list("element" "inst" "rawfile" "" "" "" t) list("outputParameter" "output" "rawfile" "" "" "" t) list("designParamVals" "parameters" "rawfile" "" "" "" t) list("primitives" "primitives" "rawfile" "" "" "" t) list("subckts" "subckts" "rawfile" "" "" "" t) list("asserts" "assert" "rawfile" "" "" "" nil) list("extremeinfo" "all" "logfile" "" "yes" "" nil) list("allcap" "allcap" "file" "" "" "" nil) list("<Click_To_Add>" "none" "rawfile" "" "" "" nil) ) )
save('i "/xdrv_p/out")

; Open CSV output file
out_file = outfile("ml_prediction_results.csv")
fprintf(out_file "Test_No,Test_Case,Process,Vreg,Temperature,GT_pvtp,GT_pvtn,ML_pvtp,ML_pvtn,Simulated_pup(Ohms),Simulated_pdn(Ohms),Excel_pup,Excel_pdn\n")

; ========== Test Case 1: tt_vdd_temp_0 [TT] (Temp=-40.0, Vreg=0.81) ==========
printf("\n>>> Running Test 1/12: tt_vdd_temp_0 [TT] (Temp=-40.0, Vreg=0.81) <<<\n")
modelFile( 
    '("/data/cad/pdk_all/pdk_tsmc/pdk_tsmc_28/PDK/TSMC_new_iPDK/models/spectre/crn28hpcp_2d5_elk_v1d0_2p2_shrink0d9_embedded_usage.scs" "ttmacro_mos_moscap")
    '("/data/cad/pdk_all/pdk_tsmc/pdk_tsmc_28/PDK/TSMC_new_iPDK/models/spectre/crn28hpcp_2d5_elk_v1d0_2p2_shrink0d9_embedded_usage.scs" "tt_res_bip_dio_disres")
)
analysis('dc ?saveOppoint t)
analysis('tran ?stop "300n")
desVar("tem" -40.0)
desVar("vreg" 0.81)
temp(-40.0)
desVar("pvt0" 1)
desVar("pvt1" 1)
desVar("pvt2" 1)
desVar("pvt3" 1)
desVar("pvt4" 1)
desVar("pvt5" 0)
desVar("pvt6" 0)
desVar("pvt7" 0)
desVar("pvt8" 0)
desVar("pvt9" 0)
desVar("pvt10" 0)
desVar("pvt11" 0)
desVar("pvt12" 0)
desVar("pvt13" 0)
desVar("pvtn0" 1)
desVar("pvtn1" 1)
desVar("pvtn2" 1)
desVar("pvtn3" 1)
desVar("pvtn4" 1)
desVar("pvtn5" 0)
desVar("pvtn6" 0)
desVar("pvtn7" 0)
desVar("pvtn8" 0)
desVar("pvtn9" 0)
desVar("pvtn10" 0)
desVar("pvtn11" 0)
desVar("pvtn12" 0)
desVar("pvtn13" 0)

run()
selectResults('tran)

pup_val = average((clip((v("/vdd" ?result "tran") - v("/outn" ?result "tran")) 2e-07 2.5e-07) / clip(i("/xdrv_p/out" ?result "tran") 2e-07 2.5e-07)))
pdn_val = (average((clip(v("/outp" ?result "tran") 2e-07 2.5e-07) / clip(i("/xdrv_p/out" ?result "tran") 2e-07 2.5e-07))) * -1)

fprintf(out_file "1, tt_vdd_temp_0, TT, 0.81, -40.0, 0001-1111, 0001-1111, 1-1111, 1-1111, %f, %f, -49.622129, 49.531058\n" pup_val pdn_val)
printf("  Result: pup=%f, pdn=%f\n" pup_val pdn_val)

