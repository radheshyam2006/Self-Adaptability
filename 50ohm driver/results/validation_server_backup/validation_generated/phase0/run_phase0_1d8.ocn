)
; --- Sim 1: Corner=TT, Vreg=0.89V, Temp=18.0C, pvtp=31, pvtn=31 ---
printf("\n[Sim 1] Running TT at Vreg=0.89, Temp=18.0...\n")
desVar("tem" 18.0)
desVar("vreg" 0.89)
temp(18.0)
desVar("pvt0" 1)
desVar("pvt1" 1)
desVar("pvt2" 1)
desVar("pvt3" 1)
desVar("pvt4" 1)
desVar("pvt5" 0)
desVar("pvt6" 0)
desVar("pvt7" 0)
desVar("pvt8" 0)
desVar("pvt9" 0)
