pdn_val = (average((clip(v("/outp" ?result "tran") 2e-07 2.5e-07) / clip(i("/xdrv_p/out" ?result "tran") 2e-07 2.5e-07))) * -1)
fprintf(out_file "GOOD_35,SF,SF Cross Option 2 (FF Res),ff_res_bip_dio_disres,0.99,125.0,312833150,123,125,%f,%f,51.49,51.13\n" pup_val pdn_val)
drain(out_file)
printf("Result GOOD_35 -> pup=%f, pdn=%f (Target: pup=51.49, pdn=51.13)\n" pup_val pdn_val)

close(out_file)
printf("\n=== JOB 6 (SF_both_res) COMPLETED! Results saved to results_job6_SF_both_res.csv ===\n")
exit()
