;====================Set to Maestro mode explorer =============================
ocnSetXLMode("explorer")
ocnxlProjectDir( "~/simulation" )
ocnxlTargetCellView( "tsmc28_tx_tb" "tx_drv_ML" "maestro" )
ocnxlResultsLocation( "" )
ocnxlSimResultsLocation( "" )
ocnxlMaxJobFail( 20 )

;====================== Tests setup ============================================

;---------- Test "tsmc28_tx_tb:tx_drv_ML:1" ------------- 
ocnxlBeginTest("tsmc28_tx_tb:tx_drv_ML:1")
simulator( 'spectre )
design( "tsmc28_tx_tb" "tx_drv_ML" "schematic_seriliazer_top")
modelFile( 
    '("/data/cad/pdk_all/pdk_tsmc/pdk_tsmc_28/PDK/TSMC_new_iPDK/models/spectre/crn28hpcp_2d5_elk_v1d0_2p2_shrink0d9_embedded_usage.scs" "fsmacro_mos_moscap")
    '("/data/cad/pdk_all/pdk_tsmc/pdk_tsmc_28/PDK/TSMC_new_iPDK/models/spectre/crn28hpcp_2d5_elk_v1d0_2p2_shrink0d9_embedded_usage.scs" "ff_res_bip_dio_disres")
)
analysis('dc ?saveOppoint t  )
analysis('tran ?stop "500n"  )
desVar(	  "pvt10" 0	)
desVar(	  "pvt11" 0	)
desVar(	  "pvt12" 0	)
desVar(	  "pvt13" 0	)
desVar(	  "pvt0" 0	)
desVar(	  "pvt1" 0	)
desVar(	  "pvt2" 1	)
desVar(	  "pvt3" 1	)
desVar(	  "pvt4" 0	)
desVar(	  "pvt5" 0	)
desVar(	  "pvt6" 0	)
desVar(	  "pvt7" 0	)
desVar(	  "pvt8" 0	)
desVar(	  "pvt9" 0	)
desVar(	  "pvtn10" 0	)
desVar(	  "pvtn11" 0	)
desVar(	  "pvtn12" 0	)
desVar(	  "pvtn13" 0	)
desVar(	  "pvtn0" 1	)
desVar(	  "pvtn1" 0	)
desVar(	  "pvtn2" 1	)
desVar(	  "pvtn3" 1	)
desVar(	  "pvtn4" 0	)
desVar(	  "pvtn5" 0	)
desVar(	  "pvtn6" 0	)
desVar(	  "pvtn7" 0	)
desVar(	  "pvtn8" 0	)
desVar(	  "pvtn9" 0	)
desVar(	  "vreg" 0.99	)
desVar(	  "tem" 10	)
envOption(
	'termDirectionMismatch  "ignore" 
	'termMismatch  "ignore" 
	'analysisOrder  list("pz" "dcmatch" "stb" "tran" "envlp" "ac" "dc" "lf" "noise" "xf" "sp" "pss" "pac" "pstb" "pnoise" "pxf" "psp" "qpss" "qpac" "qpnoise" "qpxf" "qpsp" "hb" "hbac" "hbstb" "hbnoise" "hbxf" "sens" "acmatch") 
)
option(	'pzSeverity  "None" 
	'noiseSeverity  "None" 
	'spSeverity  "None" 
	'acSeverity  "None" 
	'dcOpSeverity  "None" 
	'dcSeverity  "None" 
	'tranSeverity  "None" 
	'temp  "VAR(\"tem\")" 
)
option( ?categ 'turboOpts
	'disableVddOverride  nil 
	'errorLevel  "Conservative" 
)
saveOption( ?infoOptions list(list("modelParameter" "models" "rawfile" "" "" "" t) list("element" "inst" "rawfile" "" "" "" t) list("outputParameter" "output" "rawfile" "" "" "" t) list("designParamVals" "parameters" "rawfile" "" "" "" t) list("primitives" "primitives" "rawfile" "" "" "" t) list("subckts" "subckts" "rawfile" "" "" "" t) list("asserts" "assert" "rawfile" "" "" "" nil) list("extremeinfo" "all" "logfile" "" "yes" "" nil) list("allcap" "allcap" "file" "" "" "" nil) list("<Click_To_Add>" "none" "rawfile" "" "" "" nil) ) )
save( 'i "/xdrv_p/out" )
temp( "VAR(\"tem\")" ) 
ocnxlOutputExpr( "average((clip((v(\"/vdd\" ?result \"tran\") - v(\"/outn\" ?result \"tran\")) 2e-07 2.5e-07) / clip(i(\"/xdrv_p/out\" ?result \"tran\") 2e-07 2.5e-07)))" ?name "pup" ?evalType 'point)
ocnxlOutputExpr( "(average((clip(v(\"/outp\" ?result \"tran\") 2e-07 2.5e-07) / clip(i(\"/xdrv_p/out\" ?result \"tran\") 2e-07 2.5e-07))) * -1)" ?name "pdn" ?plot t ?evalType 'point)
ocnxlOutputTerminal( "/xdrv_p/out" ?save t)
ocnxlEndTest() ; "tsmc28_tx_tb:tx_drv_ML:1"

